.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# Pliki konfiguracyjne IDE
.vscode/
.idea/
*.swp

# Pliki logów i raportów
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Klucze i certyfikaty
*.pem
*.key

# Vercel
.vercel

